# Application
APP_NAME=search-service
APP_ENV=dev
LOG_LEVEL=INFO

# Auth
API_BEARER_TOKEN=change-me-to-a-secure-random-token

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=products
QDRANT_VECTOR_SIZE=1024

# Redis
REDIS_URL=redis://localhost:6379/0

# MySQL (read-only access)
MYSQL_DSN=mysql+aiomysql://USER:PASSWORD@localhost:3306/DATABASE

# Embedding model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

# Reranker model
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Indexing
INDEXING_CHUNK_SIZE=128
INDEXING_QUEUE=search-indexing

# Search
SEARCH_TOP_K_VECTOR=50
SEARCH_TOP_K_FINAL=10
SEARCH_RERANK_THRESHOLD=10

# Cache
CACHE_QUERY_EMBEDDING_TTL=3600

# Providers (comma-separated dotted paths to provider classes)
PROVIDERS_CLASSES=
